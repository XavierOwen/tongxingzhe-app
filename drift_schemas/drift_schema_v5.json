  "fixed_sql": [
    {
      "name": "db_users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_users\" (\"user_id\" TEXT NOT NULL, \"username\" TEXT NOT NULL UNIQUE, \"display_name\" TEXT NOT NULL, \"email\" TEXT NOT NULL, \"phone\" TEXT NOT NULL, \"birthday\" INTEGER NULL, \"gender\" TEXT NOT NULL DEFAULT 'unknown', \"occupation\" TEXT NOT NULL DEFAULT '', \"contact_json\" TEXT NOT NULL DEFAULT '{}', \"role_level\" INTEGER NOT NULL, \"city_names_json\" TEXT NOT NULL, \"team_name\" TEXT NOT NULL, \"password_md5\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"failed_login_count\" INTEGER NOT NULL DEFAULT 0, \"must_change_password\" INTEGER NOT NULL DEFAULT 0 CHECK (\"must_change_password\" IN (0, 1)), \"locked_until\" INTEGER NULL, \"last_seen_at\" INTEGER NULL, \"last_failed_login_at\" INTEGER NULL, PRIMARY KEY (\"user_id\"));"
        }
      ]
    },
    {
      "name": "db_conversation_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_conversation_records\" (\"record_id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"collector_user_id\" TEXT NOT NULL, \"city_name\" TEXT NOT NULL, \"area_name\" TEXT NOT NULL DEFAULT 'unassigned', \"team_name\" TEXT NOT NULL, \"recorder_name\" TEXT NOT NULL, \"person_name\" TEXT NOT NULL, \"english_name\" TEXT NOT NULL, \"average_heart_rate\" REAL NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"location_accuracy_meters\" REAL NULL, \"location_error\" TEXT NULL, \"manual_place_name\" TEXT NOT NULL, \"gender\" TEXT NOT NULL, \"identity\" TEXT NOT NULL, \"age_range\" TEXT NOT NULL, \"relationship_level\" INTEGER NOT NULL DEFAULT 1, \"interest_level\" INTEGER NOT NULL DEFAULT 2, \"attitude_level\" INTEGER NOT NULL, \"notes\" TEXT NOT NULL, \"is_location_verified\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_location_verified\" IN (0, 1)), \"corrected_latitude\" REAL NULL, \"corrected_longitude\" REAL NULL, \"corrected_place_name\" TEXT NULL, \"corrected_at\" INTEGER NULL, PRIMARY KEY (\"record_id\"));"
        }
      ]
    },
    {
      "name": "db_record_contacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_record_contacts\" (\"contact_id\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"channel\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"contact_id\"));"
        }
      ]
    },
    {
      "name": "db_app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "db_security_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"db_security_events\" (\"event_id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"event_type\" TEXT NOT NULL, \"event_detail_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    }
  ]
