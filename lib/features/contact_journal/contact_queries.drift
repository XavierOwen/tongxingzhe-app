import 'contact_tables.dart';

-- 个人期间汇总只计算当前有效、已提交的接触。
-- 时间区间采用 [from_utc, until_utc) 半开区间，避免相邻日／周重复计数。
-- `COUNT(*)` 的单位是接触场次；`SUM(reach_count)` 的单位是自然人次，二者
-- 不可互换。兴趣是有序等级，因此先保存五档分布，不用平均值代替分布。
readPersonalContactSummary(
  REQUIRED :app_user_id AS TEXT,
  REQUIRED :workspace_id AS TEXT,
  REQUIRED :project_id AS TEXT,
  REQUIRED :from_utc AS DATETIME,
  REQUIRED :until_utc AS DATETIME
):
SELECT
  COUNT(*) AS contact_session_count,
  COALESCE(SUM(contact.reach_count), 0) AS reach_count,
  COALESCE(SUM(CASE WHEN contact.interest_level = 0 THEN 1 ELSE 0 END), 0)
    AS interest_0_count,
  COALESCE(SUM(CASE WHEN contact.interest_level = 1 THEN 1 ELSE 0 END), 0)
    AS interest_1_count,
  COALESCE(SUM(CASE WHEN contact.interest_level = 2 THEN 1 ELSE 0 END), 0)
    AS interest_2_count,
  COALESCE(SUM(CASE WHEN contact.interest_level = 3 THEN 1 ELSE 0 END), 0)
    AS interest_3_count,
  COALESCE(SUM(CASE WHEN contact.interest_level = 4 THEN 1 ELSE 0 END), 0)
    AS interest_4_count,
  COALESCE(SUM(
    CASE WHEN EXISTS (
      SELECT 1
      FROM db_sync_outbox AS outbox
      WHERE outbox.aggregate_id = contact.contact_id
        AND outbox.status != 'completed'
    ) THEN 1 ELSE 0 END
  ), 0) AS pending_sync_count
FROM db_contact_records AS contact
WHERE contact.app_user_id = :app_user_id
  AND contact.workspace_id = :workspace_id
  AND contact.project_id = :project_id
  AND contact.occurred_at_utc >= :from_utc
  AND contact.occurred_at_utc < :until_utc
  AND contact.lifecycle_status = 'active';
