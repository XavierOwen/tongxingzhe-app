# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local configuration and secrets must never be committed.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local databases and exports can contain collected personal data.
*.db
*.sqlite
*.sqlite3
*.csv
# 只允许提交数据库合同测试使用的 synthetic 小型 fixture。
!backend/database/fixtures/shared/*.csv
*.xlsx
